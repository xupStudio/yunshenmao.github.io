{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "yunshenmao-site",
  "main": "./workers/site-runtime/src/index.ts",
  "compatibility_date": "2026-07-29",
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "yunshenmao.com",
      "custom_domain": true
    },
    {
      "pattern": "www.yunshenmao.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/photos/journal/*"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "r2_buckets": [
    {
      "binding": "JOURNAL_STORAGE",
      "bucket_name": "yunshenmao-journal"
    }
  ],
  "triggers": {
    "crons": ["0 3 * * *"]
  },
  "vars": {
    "FACEBOOK_API_VERSION": "v25.0",
    "GEMINI_MODEL": "gemini-2.5-flash"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
