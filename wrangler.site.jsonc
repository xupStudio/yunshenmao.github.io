{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "yunshenmao-site",
  "compatibility_date": "2026-07-29",
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "yunshenmao.com",
      "custom_domain": true
    },
    {
      "pattern": "www.yunshenmao.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./out",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true
  }
}
